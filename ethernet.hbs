namespace eval vhdl::ethernet {

    # Package with CRCs used in Ethernet.
    namespace eval crc {
      proc src {} {
        hbs::SetLib "ethernet"
        hbs::AddFile crc.vhd
      }

      hbs::Register
    }

    # Management Data Input/Output Station Manager
    namespace eval mdio {
      proc src {} {
        hbs::SetLib "ethernet"
        hbs::SetStd 2019
        hbs::AddFile mdio.vhd
      }

      proc tb {} {
        hbs::SetTool "nvc"
        hbs::AddPostElabCb hbs::SetArgPrefix "--messages=compact"
        src

        hbs::SetLib ""
        hbs::AddFile tb/tb_mdio.vhd
        hbs::SetTop "tb_mdio"
        hbs::Run
      }

      hbs::Register
    }

    # GMII Tx path tester
    namespace eval gmii_tx_tester {
      proc src {} {
        hbs::AddDep vhdl::ethernet::crc::src

        hbs::SetLib "ethernet"
        hbs::SetStd 2019
        hbs::AddFile gmii_tx_tester.vhd
      }

      proc tb {} {
        hbs::SetTool "nvc"
        hbs::AddPostElabCb hbs::SetArgPrefix "--messages=compact"
        src

        hbs::SetLib ""
        hbs::AddFile tb/tb_gmii_tx_tester.vhd
        hbs::SetTop "tb_gmii_tx_tester"
        hbs::Run
      }

      hbs::Register
    }

  namespace eval xgmii_rx {
    set doc "32-bit XGMII receiver forwarding Ethernet frames, including FCS, to AXI Stream."

    proc src {} {
      hbs::AddDep vhdl::amba5::axi-stream::pkg::src
      hbs::SetStd 2008
      hbs::SetLib ""
      hbs::AddFile xgmii_rx.vhd
    }

    proc tb_valid_frame {} {
      hbs::SetTool "nvc"

      hbs::AddDep vhdl::amba5::data::src
      hbs::AddDep vhdl::amba5::axi-stream::buffer_receiver::src
      hbs::AddDep vhdl::amba5::axi-stream::checker::src

      src
      hbs::SetTop "tb_valid_frame"
      hbs::AddFile tb/xgmii_rx/tb_valid_frame.vhd
      hbs::Run
    }

    hbs::Register $doc
  }
}
